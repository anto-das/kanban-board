model Board {
    id        String   @id @default(uuid())
    name      String
    ownerId   String
    owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    members   Member[]
    columns   Column[]

    @@index([ownerId], name: "owner_index")
}
